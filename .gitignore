# GSD planning artifacts stay local. This repository is public, and the planning
# notes carry entity names, addresses, and other details of one specific house.
.planning/

# Real configuration. Only config.example.yaml belongs in git.
config/config.yaml
config/*.local.yaml
.env
.env.*
!.env.example

# Recorded voice sessions: audio, transcripts, and timelines of real speech.
# Anchored to the repo root (leading slash) -- an unanchored `sessions/`
# also matched `web/src/routes/sessions/` (Phase 8, WEB-07), silently
# hiding that screen's whole source directory from git.
/data/
/sessions/

# The measurement harness's fixture (plan 01.1-07): a real person's voice
# naming real things in a real house. DEP-05 keeps entity names, addresses,
# and credentials out of the repository and its history -- a committed WAV
# is unrecoverable from history in a way a committed string is not, so the
# operator supplies this file locally and the repo never ships one.
tests/fixtures/*.wav

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# `tests/test_web_typecheck.py` writes this probe into the tracked source
# tree (it has to be somewhere `tsconfig.app.json` includes) and removes it
# in a `finally`. A SIGKILL or a timeout during `bunx tsc -b` leaves it
# behind, where `git status` shows it as untracked source and a later
# `git add -A` would commit a deliberate type error into the repository.
web/src/__typecheck_probe__.ts

# Models are large binaries, downloaded at build or first run.
models/

# D-18 spike recordings (edge/spike/run_spike.py): real speech in a real
# house. The ignore rule lands in the same task that first writes a
# recording (10-01-PLAN.md Task 2), before anything is captured.
edge/spike/results/

# OS
.DS_Store

# GSD run-scoped dispatch state (machine-local, never committed)
.gsd/

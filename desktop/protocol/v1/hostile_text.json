{
  "description": "Shared vectors for sanitize_display_text (Python) and TextSanitizer.sanitize (Swift). max counts unicode scalars. Both suites read this file.",
  "vectors": [
    {
      "name": "long_5000_keep_start",
      "input": "",
      "max": 600,
      "keep": "start",
      "expected": "\u2026"
    },
    {
      "name": "long_1000_keep_end",
      "input": "",
      "max": 500,
      "keep": "end",
      "expected": "\"
    },
    {
      "name": "rtl_override_inside_a_word",
      "input": "pay\u202epal",
      "max": 600,
      "keep": "start",
      "expected": "paypal"
    },
    {
      "name": "bidi_isolates_embeddings_and_marks",
      "input": "a\u2066b\u2067c\u2068d\u2069e\u200ef\u200fg\u061ch\u202ai\u202bj\u202ck\u202dl",
      "max": 600,
      "keep": "start",
      "expected": "abcdefghijkl"
    },
    {
      "name": "markdown_link_stays_literal",
      "input": "[text](https://example.com)",
      "max": 600,
      "keep": "start",
      "expected": "[text](https://example.com)"
    },
    {
      "name": "c0_and_c1_controls_removed",
      "input": "a\u0000b\u0001c\u001bd\u001fe\u007ff\u0080g\u0090h\u009fi",
      "max": 600,
      "keep": "start",
      "expected": "abcdefghi"
    },
    {
      "name": "next_line_becomes_a_space",
      "input": "line\u0085break",
      "max": 600,
      "keep": "start",
      "expected": "line break"
    },
    {
      "name": "whitespace_runs_collapse",
      "input": "  a \t\t b\n\nc \u000b\f d  ",
      "max": 600,
      "keep": "start",
      "expected": "a b c d"
    },
    {
      "name": "only_spaces",
      "input": "      ",
      "max": 600,
      "keep": "start",
      "expected": ""
    },
    {
      "name": "only_controls",
      "input": "\u0000\u0001\u202e\u007f\u009f",
      "max": 600,
      "keep": "start",
      "expected": ""
    },
    {
      "name": "line_and_paragraph_separators",
      "input": "a\u2028b\u2029c\r\nd",
      "max": 600,
      "keep": "start",
      "expected": "a b c d"
    },
    {
      "name": "no_break_space_is_kept",
      "input": "\u00a0a\u00a0\u00a0b\u00a0",
      "max": 600,
      "keep": "start",
      "expected": "\u00a0a\u00a0\u00a0b\u00a0"
    },
    {
      "name": "emoji_with_skin_tone_is_kept",
      "input": "\ud83d\udc4d\ud83c\udffd ok",
      "max": 600,
      "keep": "start",
      "expected": "\ud83d\udc4d\ud83c\udffd ok"
    },
    {
      "name": "zero_width_joiner_is_kept",
      "input": "a\u200db",
      "max": 600,
      "keep": "start",
      "expected": "a\u200db"
    },
    {
      "name": "cut_keep_start",
      "input": "abcd efgh",
      "max": 6,
      "keep": "start",
      "expected": "abcd\u2026"
    },
    {
      "name": "cut_keep_end",
      "input": "abcd efgh",
      "max": 6,
      "keep": "end",
      "expected": "\u2026efgh"
    },
    {
      "name": "exactly_at_the_cap_is_not_cut",
      "input": "abcdef",
      "max": 6,
      "keep": "start",
      "expected": "abcdef"
    },
    {
      "name": "controls_are_removed_before_the_cap",
      "input": "ab\u202ecd",
      "max": 4,
      "keep": "start",
      "expected": "abcd"
    },
    {
      "name": "cap_counts_code_points_not_bytes",
      "input": "\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00",
      "max": 5,
      "keep": "start",
      "expected": "\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\u2026"
    }
  ]
}

# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Nothing here belongs in git. The repository is public, and HA_URL alone
# discloses a real host on a real home network.

# Phase 7 (D-15): server.bind_host and security.cookie_secure, read from
# the environment the same way every other ${VAR} in config.example.yaml
# is. These two values keep today's dev-harness behaviour identical --
# loopback, and a cookie that never claims to be secure over plain HTTP.
# docker-compose.yml sets both differently for the Compose deployment; see
# its own comments for why.
BIND_HOST=127.0.0.1
COOKIE_SECURE=false

# xAI, for speech-to-text, the language model, and text-to-speech.
# https://console.x.ai -> API Keys
XAI_API_KEY=

# Home Assistant. HA_URL is the base URL of the instance, e.g.
# http://homeassistant.lan:8123 -- no trailing slash.
#
# Create a token dedicated to atlas rather than reusing an existing one:
# Home Assistant -> Profile -> Security -> Long-lived access tokens.
HA_URL=
HA_TOKEN=

# Phase 2 (camera as microphone and speaker) uses these. Phase 1 runs on the
# browser microphone alone and never reads them, but the config file they
# appear in is expanded as one document at load, so they must be set to
# something. Leave the placeholders until Phase 2.
TAPO_USER=unused-in-phase-1
TAPO_PASSWORD=unused-in-phase-1
SPEAKER_ENSURE_URL=http://127.0.0.1:59998

# 260922-cmo (D-1): the whole authenticated camera URL and the speaker
# backend choice, read directly by config.example.yaml's camera.rtsp_url
# and speaker.backend. Leave the placeholders until Phase 2 the same way
# as the TAPO_* values above -- a real camera URL never belongs in git.
CAMERA_RTSP_URL=rtsp://unused-in-phase-1:unused-in-phase-1@camera.invalid:554/stream1
SPEAKER_BACKEND=go2rtc
# Set SPEAKER_BACKEND=tcp and this to the tcp://host:port of a listener
# that plays the reply audio, for example a Raspberry Pi. Leave it empty
# on go2rtc and tapo_talk. A real address never belongs in git.
SPEAKER_TCP_URL=
# This is the reply audio format. go2rtc and tapo_talk need alaw and 8000
# -- startup refuses anything else on them. With SPEAKER_BACKEND=tcp, pcm
# and 24000 sound better. These values must be non-empty: expand_env only
# uses the default below for an absent variable, so an empty value here
# would reach TtsConfig as "" and stop startup.
TTS_CODEC=alaw
TTS_SAMPLE_RATE=8000

# 260922-fmi (D-15, D-20): the calibration echo-path route's on/off
# switch. Safe default false; only the operator's hand-applied cluster
# Secret ever sets this true.
CALIBRATION_ROUTE_ENABLED=false

# Comma-separated words speech-to-text is biased toward: the wake word plus
# the device names you actually say (stt.keyterms in config.yaml).
STT_KEYTERMS=Atlas

# The Tapo cloud-account password, read directly from the environment by
# speaker/tapo_talk.py (never through config.py's ${VAR} expansion -- there
# is no placeholder for it in config.example.yaml). Only used when
# speaker.backend is set to tapo_talk. Never belongs in git -- this is a
# real TP-Link/Tapo cloud account credential for a real house.
TAPO_CLOUD_PASSWORD=

# Phase 3 (the database and the admin webapp) uses these. Neither value
# belongs in git -- the repository is public.

# Where Postgres is, as the runtime asyncpg connection string. The migration
# connection is derived from this by driver swap (DatabaseConfig.migration_url)
# unless database.migration_url is set in config.yaml to override it.
# scripts/dev-postgres.sh prints one for a throwaway local Postgres, and
# starts it on this same port.
#
# WR-09 (code review): 54329, not 5432. Postgres's own default port is the
# one every other Postgres on a development machine is already using, and a
# connection string that silently reaches somebody else's database fails
# with an authentication error that reads like a bug in this code.
DATABASE_URL=postgresql+asyncpg://atlas:atlas@127.0.0.1:54329/atlas

# WR-09 (code review): the bundled Compose database's password. Read by
# docker-compose.yml only -- the Helm chart generates its own, and nothing
# in the application reads this name. Postgres reads it exactly once, when
# its data volume is still empty, so set it before the first
# `docker compose up` or not at all: changing it afterwards does nothing to
# the database that is already initialized.
#
# Left blank here means the Compose default (`changeme`), which is bounded
# by the db service publishing no port at all -- see
# docs/runbooks/deploy-compose.md before you widen anything.
POSTGRES_PASSWORD=

# The host port the Compose deployment publishes the webapp on, bound to
# this host's loopback address only. Read by docker-compose.yml alone;
# the application always listens on 8080 inside its container.
#
# Found by the same WR-09 test that found POSTGRES_PASSWORD: Compose read
# this name and nothing told an operator it existed.
ATLAS_PORT=8080

# The key provider credentials are encrypted at rest with (PROV-04). Generate
# one with:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored credential permanently unreadable --
# back it up the way you would any other secret, never in this repository.
ATLAS_SECRET_KEY=

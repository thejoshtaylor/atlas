# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Nothing here belongs in git. The repository is public, and HA_URL alone
# discloses a real host on a real home network.

# xAI, for speech-to-text, the language model, and text-to-speech.
# https://console.x.ai -> API Keys
XAI_API_KEY=

# Home Assistant. HA_URL is the base URL of the instance, e.g.
# http://homeassistant.lan:8123 -- no trailing slash.
#
# Create a token dedicated to spire-voice rather than reusing an existing one:
# Home Assistant -> Profile -> Security -> Long-lived access tokens.
HA_URL=
HA_TOKEN=

# Phase 2 (camera as microphone and speaker) uses these. Phase 1 runs on the
# browser microphone alone and never reads them, but the config file they
# appear in is expanded as one document at load, so they must be set to
# something. Leave the placeholders until Phase 2.
TAPO_USER=unused-in-phase-1
TAPO_PASSWORD=unused-in-phase-1
SPEAKER_ENSURE_URL=http://127.0.0.1:59998

# Phase 3 (the database and the admin webapp) uses these. Neither value
# belongs in git -- the repository is public.

# Where Postgres is, as the runtime asyncpg connection string. The migration
# connection is derived from this by driver swap (DatabaseConfig.migration_url)
# unless database.migration_url is set in config.yaml to override it.
# scripts/dev-postgres.sh prints one for a throwaway local Postgres.
DATABASE_URL=postgresql+asyncpg://spire:spire@127.0.0.1:5432/spire

# The key provider credentials are encrypted at rest with (PROV-04). Generate
# one with:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored credential permanently unreadable --
# back it up the way you would any other secret, never in this repository.
SPIRE_SECRET_KEY=
